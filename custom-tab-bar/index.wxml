<view class="hg-tabbar {{ isBlackbox ? 'hg-tabbar--blackbox' : '' }}">
  <view
    class="hg-tabbar__item {{ value === item.value ? 'hg-tabbar__item--on' : '' }}"
    wx:for="{{ list }}"
    wx:key="value"
    data-value="{{ item.value }}"
    hover-class="hg-tabbar__item--hover"
    bindtap="handleChange"
    aria-role="button"
    aria-label="{{ isBlackbox && item.value === 'home' ? '首页' : item.label }}"
  >
    <t-icon
      class="hg-tabbar__icon"
      name="{{ value === item.value ? item.iconActive : item.icon }}"
      size="44rpx"
    />
    <text class="hg-tabbar__label">{{ isBlackbox && item.value === 'home' ? '首页' : item.label }}</text>
  </view>
</view>
