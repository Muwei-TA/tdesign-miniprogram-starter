<view class="hg-page hg-search">
  <hg-nav title="搜索" />

  <view class="hg-search__bar">
    <t-icon name="search" size="34rpx" />
    <input
      class="hg-search__input"
      value="{{ keyword }}"
      placeholder="找回一句话、一张照片"
      confirm-type="search"
      focus
      bindinput="onInput"
      bindconfirm="onSubmit"
    />
  </view>

  <view class="hg-search__segmented">
    <view
      wx:for="{{ scopes }}"
      wx:key="value"
      class="hg-search__seg {{ scope === item.value ? 'hg-search__seg--on' : '' }}"
      data-value="{{ item.value }}"
      bindtap="onScopeTap"
      aria-role="button"
    >
      {{ item.label }}
    </view>
  </view>

  <!-- 未输入：推荐词 -->
  <block wx:if="{{ !searched }}">
    <view class="hg-search__section">
      <view class="hg-search__section-title">可以先看看这些</view>
      <view class="hg-search__chips">
        <view
          wx:for="{{ suggestions }}"
          wx:key="*this"
          class="hg-search__chip"
          data-word="{{ item }}"
          bindtap="onSuggestionTap"
          aria-role="button"
        >
          {{ item }}
        </view>
      </view>
      <view class="hg-search__note">
        推荐词由运营者维护，不会从私密内容里自动抽取。搜索只在你有权限的范围内进行。
      </view>
    </view>
  </block>

  <!-- 结果 -->
  <block wx:else>
    <view class="hg-search__results">
      <block wx:if="{{ results.length > 0 && scope === 'post' }}">
        <post-card
          wx:for="{{ results }}"
          wx:key="id"
          post="{{ item }}"
          mode="compact"
          show-actions="{{ false }}"
          bind:tapbody="onResultTap"
        />
      </block>

      <block wx:elif="{{ results.length > 0 }}">
        <topic-card wx:for="{{ results }}" wx:key="id" topic="{{ item }}" bind:tap="onResultTap" />
      </block>

      <empty-state
        wx:elif="{{ errorText }}"
        icon="error-circle"
        title="查询没有完成"
        desc="{{ errorText }}"
        action="再试一次"
        bind:action="onRetry"
      />

      <empty-state
        wx:elif="{{ !loading }}"
        icon="search"
        title="暂时没找到"
        desc="换一个词试试。\n只有你有权限看到的内容才会出现在结果里。"
      />
    </view>
  </block>
</view>
