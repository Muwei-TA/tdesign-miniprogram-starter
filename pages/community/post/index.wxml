<view class="hg-page hg-detail {{ nightMode && post.kind === 'article' ? 'hg-detail--night' : '' }}">
  <hg-nav
    title="{{ post && post.kind === 'article' ? '' : '内容' }}"
    theme="{{ nightMode && post.kind === 'article' ? 'dark' : 'paper' }}"
  />

  <!-- 统一不可访问态：不显示标题 -->
  <empty-state
    wx:if="{{ notAccessible }}"
    icon="lock-on"
    title="这条内容当前不可访问"
    desc="它可能已被作者调整了可见范围，\n或者需要社内成员资格。"
    action="回树洞"
    bind:action="onBackHome"
  />

  <empty-state
    wx:elif="{{ errorText }}"
    icon="error-circle"
    title="没能读到内容"
    desc="{{ errorText }}"
    action="再试一次"
    bind:action="onRetry"
  />

  <block wx:elif="{{ post }}">
    <!-- 长文阅读 -->
    <block wx:if="{{ post.kind === 'article' }}">
      <view class="hg-detail__reader">
        <view class="hg-detail__kicker">{{ post.categoryText }} · {{ post.createdAtText }}</view>
        <view class="hg-detail__headline">{{ post.title }}</view>

        <view class="hg-detail__author" bindtap="onTapAuthor" aria-role="button">
          <view class="hg-detail__avatar {{ post.author.isAnonymous ? 'hg-detail__avatar--anon' : '' }}">
            {{ post.author.isAnonymous ? post.author.alias[0] : post.author.displayName[0] }}
          </view>
          <view class="hg-detail__author-main">
            <view class="hg-detail__author-name">
              {{ post.author.isAnonymous ? post.author.alias : post.author.displayName }}
            </view>
            <view wx:if="{{ post.author.isAnonymous }}" class="hg-detail__author-note">树洞身份 · 点击了解</view>
          </view>
          <visibility-badge scope="{{ post.visibility }}" />
        </view>

        <view class="hg-detail__tools">
          <view class="hg-detail__tool" data-step="-1" bindtap="onFontChange" aria-role="button" aria-label="缩小字号">A-</view>
          <view class="hg-detail__tool-label">字号</view>
          <view class="hg-detail__tool" data-step="1" bindtap="onFontChange" aria-role="button" aria-label="放大字号">A+</view>
          <view class="hg-detail__tool hg-detail__tool--right" bindtap="onNightToggle" aria-role="button">
            <t-icon name="{{ nightMode ? 'sunny' : 'moon' }}" size="30rpx" />
            <text>{{ nightMode ? '日间' : '夜间' }}</text>
          </view>
        </view>

        <view class="hg-detail__article" style="font-size: {{ fontSize }}rpx">
          <view wx:for="{{ post.paragraphs }}" wx:key="index" class="hg-detail__para">{{ item }}</view>
        </view>
        <view class="hg-detail__end">· · ·</view>

        <view wx:if="{{ post.media.type === 'image' }}" class="hg-detail__images">
          <image
            wx:for="{{ post.media.images }}"
            wx:key="*this"
            class="hg-detail__image"
            src="{{ item }}"
            mode="widthFix"
            data-index="{{ index }}"
            bindtap="onPreviewImage"
            aria-label="文章配图"
          />
        </view>
      </view>
    </block>

    <!-- 碎片详情 -->
    <block wx:else>
      <view class="hg-detail__fragment">
        <view class="hg-detail__author" bindtap="onTapAuthor" aria-role="button">
          <view class="hg-detail__avatar {{ post.author.isAnonymous ? 'hg-detail__avatar--anon' : '' }}">
            {{ post.author.isAnonymous ? post.author.alias[0] : post.author.displayName[0] }}
          </view>
          <view class="hg-detail__author-main">
            <view class="hg-detail__author-name">
              {{ post.author.isAnonymous ? post.author.alias : post.author.displayName }}
            </view>
            <view class="hg-detail__author-note">{{ post.createdAtText }}</view>
          </view>
          <visibility-badge scope="{{ post.visibility }}" />
          <view wx:if="{{ post.visibility !== 'private' }}" class="hg-detail__more" catchtap="onMoreOpen" aria-role="button" aria-label="更多">
            <t-icon name="ellipsis" size="34rpx" />
          </view>
        </view>

        <view wx:if="{{ post.title }}" class="hg-detail__subtitle">{{ post.title }}</view>
        <view class="hg-detail__body">{{ post.body }}</view>

        <view wx:if="{{ post.media.type === 'image' }}" class="hg-detail__images">
          <image
            wx:for="{{ post.media.images }}"
            wx:key="*this"
            class="hg-detail__image"
            src="{{ item }}"
            mode="widthFix"
            data-index="{{ index }}"
            bindtap="onPreviewImage"
            aria-label="内容配图"
          />
        </view>

        <!-- 视频未完成处理时不提供播放 -->
        <view wx:if="{{ post.media.type === 'video' }}" class="hg-detail__video">
          <video
            wx:if="{{ post.media.video.ready && post.media.video.url }}"
            class="hg-detail__video-player"
            src="{{ post.media.video.url }}"
            poster="{{ post.media.video.cover }}"
            autoplay="{{ false }}"
            show-center-play-btn
            object-fit="cover"
          />
          <view wx:else class="hg-detail__video-pending">
            这段视频正在处理，完成审核后才会展示。
          </view>
        </view>

        <view wx:if="{{ post.event }}" class="hg-detail__event">
          <view class="hg-detail__event-row">时间 · {{ post.event.dateText }}</view>
          <view class="hg-detail__event-row">地点 · {{ post.event.place }}</view>
          <view class="hg-detail__event-note">这只是意向，不需要报名，也可以随时取消。</view>
        </view>

        <view wx:if="{{ post.topic }}" class="hg-detail__topic" bindtap="onTapTopic" aria-role="button">
          <t-icon name="chat-bubble-1" size="24rpx" />
          <text>{{ post.topic.title }}</text>
        </view>

        <view wx:if="{{ post.statusText }}" class="hg-detail__status">{{ post.statusText }}</view>
      </view>
    </block>

    <!-- 互动条：private 不展示 -->
    <view wx:if="{{ post.visibility !== 'private' && post.status === 'published' }}" class="hg-detail__actions">
      <view class="hg-detail__action {{ post.viewer.reacted ? 'hg-detail__action--on' : '' }}" bindtap="onReact" aria-role="button">
        <t-icon name="{{ post.viewer.reacted ? 'heart-filled' : 'heart' }}" size="32rpx" />
        <text>共鸣 {{ post.counters.reactions }}</text>
      </view>
      <view class="hg-detail__action" bindtap="onCommentPlaceholder" aria-role="button">
        <t-icon name="chat-bubble-1" size="32rpx" />
        <text>回应 {{ post.counters.comments }}</text>
      </view>
      <view class="hg-detail__action {{ post.viewer.bookmarked ? 'hg-detail__action--on' : '' }}" bindtap="onBookmark" aria-role="button">
        <t-icon name="{{ post.viewer.bookmarked ? 'bookmark-filled' : 'bookmark' }}" size="32rpx" />
        <text>收藏</text>
      </view>
    </view>

    <!-- 评论区（完整交互见任务 T-06） -->
    <view wx:if="{{ post.visibility !== 'private' }}" class="hg-detail__comments">
      <view class="hg-detail__comments-title">回应</view>

      <block wx:if="{{ comments.length > 0 }}">
        <view wx:for="{{ comments }}" wx:key="id" class="hg-detail__comment">
          <view class="hg-detail__c-avatar {{ item.author.isAnonymous ? 'hg-detail__c-avatar--anon' : '' }}">
            {{ item.author.isAnonymous ? item.author.alias[0] : item.author.displayName[0] }}
          </view>
          <view class="hg-detail__c-main">
            <view class="hg-detail__c-name">
              {{ item.author.isAnonymous ? item.author.alias : item.author.displayName }}
              <text wx:if="{{ item.author.isAuthor }}" class="hg-detail__c-tag">作者</text>
              <text class="hg-detail__c-time">{{ item.createdAtText }}</text>
            </view>
            <view class="hg-detail__c-body">{{ item.body }}</view>

            <view wx:for="{{ item.replies }}" wx:for-item="reply" wx:key="id" class="hg-detail__reply">
              <view class="hg-detail__c-name">
                {{ reply.author.isAnonymous ? reply.author.alias : reply.author.displayName }}
                <text wx:if="{{ reply.author.isAuthor }}" class="hg-detail__c-tag">作者</text>
                <text class="hg-detail__c-time">{{ reply.createdAtText }}</text>
              </view>
              <view class="hg-detail__c-body">{{ reply.body }}</view>
            </view>
          </view>
        </view>
      </block>

      <view wx:elif="{{ post.commentsEnabled }}" class="hg-detail__comments-empty">还没有人回应。第一句可以很短。</view>
      <view wx:else class="hg-detail__comments-empty">作者关闭了这条内容的回应。</view>

      <view wx:if="{{ post.commentsEnabled }}" class="hg-detail__comment-input" bindtap="onCommentPlaceholder" aria-role="button">
        写下你的回应…
      </view>
    </view>

    <view class="hg-footnote">
      回应会先进入审核，通过后才会展示。评论中的树洞身份不会显示真实昵称。
    </view>
  </block>

  <!-- 更多操作 -->
  <t-popup visible="{{ moreVisible }}" placement="bottom" bind:visible-change="onMoreClose">
    <view class="hg-sheet">
      <view class="hg-sheet__head">
        <view class="hg-sheet__title">更多</view>
        <view class="hg-sheet__close" bindtap="onMoreClose" aria-role="button" aria-label="关闭">
          <t-icon name="close" size="40rpx" />
        </view>
      </view>

      <view wx:if="{{ post.viewer.canShrinkVisibility }}" class="hg-sheet__option" bindtap="onShrinkOpen" aria-role="button">
        <t-icon name="lock-on" size="36rpx" />
        <view class="hg-sheet__option-main">
          <view class="hg-sheet__option-title">缩小可见范围</view>
          <view class="hg-sheet__option-desc">首版只能缩小。需要更大受众请新建内容。</view>
        </view>
      </view>

      <view wx:if="{{ post.viewer.canReport }}" class="hg-sheet__option" bindtap="onReport" aria-role="button">
        <t-icon name="flag" size="36rpx" />
        <view class="hg-sheet__option-main">
          <view class="hg-sheet__option-title">举报这条内容</view>
          <view class="hg-sheet__option-desc">举报不等于认定违规，也不会透露举报人。</view>
        </view>
      </view>

      <view wx:if="{{ post.viewer.canDelete }}" class="hg-sheet__option" bindtap="onDelete" aria-role="button">
        <t-icon name="delete" size="36rpx" />
        <view class="hg-sheet__option-main">
          <view class="hg-sheet__option-title hg-detail__danger">删除</view>
          <view class="hg-sheet__option-desc">删除后无法恢复，相关回应一并停止展示。</view>
        </view>
      </view>
    </view>
  </t-popup>

  <scope-picker
    visible="{{ scopeVisible }}"
    value="{{ post.visibility }}"
    allow-public="{{ capabilities.publicScope }}"
    mode="shrink"
    bind:change="onScopeChange"
    bind:close="onScopeClose"
  />
</view>
