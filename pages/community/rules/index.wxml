<view class="hg-page hg-rules">
  <hg-nav title="社区约定" />

  <block wx:if="{{ loading }}">
    <view class="hg-rules__loading">
      <view class="hg-rules__skeleton hg-rules__skeleton--title"></view>
      <view class="hg-rules__skeleton hg-rules__skeleton--line"></view>
      <view class="hg-rules__skeleton hg-rules__skeleton--line hg-rules__skeleton--short"></view>
      <view class="hg-rules__skeleton hg-rules__skeleton--card"></view>
    </view>
  </block>

  <block wx:elif="{{ loadError }}">
    <empty-state
      icon="error-circle"
      title="暂时读不到约定版本"
      desc="{{ loadError }}"
      action="再试一次"
      bind:action="onRetry"
    />
  </block>

  <empty-state
    wx:elif="{{ !club }}"
    icon="secured"
    title="约定暂未发布"
    desc="社团资料准备好后，这里会展示完整的社区约定。"
    action="再试一次"
    bind:action="onRetry"
  />

  <block wx:else>
    <view class="hg-rules__intro">
      <view class="hg-rules__kicker">{{ club.name }} · COMMUNITY AGREEMENT</view>
      <view class="hg-rules__title">让表达有边界， 也让人可以放心留下。</view>
      <view class="hg-rules__desc">
        社区约定和隐私告知是两件事：同意文明讨论，不等于同意无限制使用你的个人内容。遇到争议，请走举报与申诉流程，不建立公开的曝光名单。
      </view>
    </view>

    <view class="hg-rules__source">
      <t-icon name="info-circle" size="30rpx" />
      <text
        >以下内容分为社团约定、平台要求、法律义务三层。情绪表达本身不会被机械诊断或封禁；如遇现实危险，请优先联系可信任的人或专业支持，本产品不替代专业服务。</text
      >
    </view>

    <view wx:for="{{ sections }}" wx:key="key" class="hg-rules__section">
      <view class="hg-rules__section-head">
        <view class="hg-rules__section-title">{{ item.title }}</view>
        <view class="hg-rules__section-intro">{{ item.intro }}</view>
      </view>

      <view class="hg-rules__items">
        <block wx:if="{{ item.type === 'rules' }}">
          <view wx:for="{{ item.items }}" wx:for-item="rule" wx:key="title" class="hg-rules__item">
            <view class="hg-rules__item-mark">·</view>
            <view class="hg-rules__item-main">
              <view class="hg-rules__item-title">{{ rule.title }}</view>
              <view class="hg-rules__item-body">{{ rule.body }}</view>
            </view>
          </view>
        </block>
        <block wx:else>
          <view wx:for="{{ item.items }}" wx:for-item="rule" wx:key="*this" class="hg-rules__item">
            <view class="hg-rules__item-mark">·</view>
            <view class="hg-rules__item-main">
              <view class="hg-rules__item-body">{{ rule }}</view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view class="hg-rules__version">
      <view class="hg-rules__version-head">当前版本 {{ version }}</view>
      <view class="hg-rules__version-summary">变更摘要：{{ changeSummary }}</view>
    </view>

    <view class="hg-rules__footnote"
      >阅读并理解这些约定，是申请加入文学社前需要完成的一步。返回时，原页面已填写的内容会保留。</view
    >
  </block>
</view>
