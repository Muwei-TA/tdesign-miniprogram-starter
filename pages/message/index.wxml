<view class="hg-page hg-message">
  <hg-nav title="消息">
    <view slot="right" class="hg-message__readall" bindtap="onReadAll" aria-role="button">全部已读</view>
  </hg-nav>

  <view class="hg-message__segmented">
    <view
      wx:for="{{ tabs }}"
      wx:key="value"
      class="hg-message__seg {{ tab === item.value ? 'hg-message__seg--on' : '' }}"
      data-value="{{ item.value }}"
      bindtap="onTabTap"
      aria-role="button"
    >
      {{ item.label }}
    </view>
  </view>

  <view wx:if="{{ stale }}" class="hg-message__stale">
    <text>消息未更新：{{ errorText }}</text>
    <text class="hg-message__retry" bindtap="onRetry" aria-role="button">重试</text>
  </view>

  <view class="hg-message__list" wx:if="{{ list.length > 0 }}">
    <view
      wx:for="{{ list }}"
      wx:key="id"
      class="hg-message__row"
      data-id="{{ item.id }}"
      bindtap="onItemTap"
      aria-role="button"
    >
      <view class="hg-message__icon">
        <t-icon name="{{ item.icon }}" size="34rpx" />
      </view>
      <view class="hg-message__main">
        <view class="hg-message__title">{{ item.title }}</view>
        <view wx:if="{{ item.summary }}" class="hg-message__summary">{{ item.summary }}</view>
        <view class="hg-message__time">{{ item.createdAtText }}</view>
      </view>
      <view wx:if="{{ !item.read }}" class="hg-message__dot"></view>
    </view>
  </view>

  <empty-state
    wx:elif="{{ errorText && !stale }}"
    icon="error-circle"
    title="没能读到消息"
    desc="{{ errorText }}"
    action="再试一次"
    bind:action="onRetry"
  />

  <empty-state
    wx:elif="{{ !loading }}"
    icon="notification"
    title="现在没有新消息"
    desc="有人回应你的内容时，\n会在这里提醒你。"
  />

  <view class="hg-footnote">
    首版没有私信会话。通知文案保持中性，不包含私密正文与树洞身份的真实映射。
  </view>
</view>
