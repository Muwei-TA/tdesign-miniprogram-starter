<view class="hg-page hg-page--tab hg-home">
  <hg-nav
    theme="transparent"
    show-back="{{ false }}"
  >
    <view slot="left" class="hg-home__notice" hover-class="hg-home__notice--hover" bindtap="onNoticeTap" aria-role="button" aria-label="消息">
      <t-icon name="notification" size="42rpx" />
      <view wx:if="{{ unread > 0 }}" class="hg-home__notice-dot"></view>
    </view>
  </hg-nav>

  <view class="hg-home__club-switch" bindtap="onClubSwitchTap" aria-role="button" aria-label="切换社团">
    <text class="hg-home__club-name">{{ clubName || '选择社团' }}</text>
    <text class="hg-home__club-action">{{ clubName ? '切换' : '加入社团' }}</text>
    <t-icon name="chevron-right" size="28rpx" />
  </view>

  <!-- 只展示服务端返回的 active 板块；空状态不填充示例卡 -->
  <view class="hg-home__recommend">
    <view class="hg-home__recommend-head">
      <text class="hg-home__recommend-title">推荐板块</text>
      <view class="hg-home__recommend-more" hover-class="hg-home__recommend-more--hover" bindtap="onMoreRecommendations" aria-role="button" aria-label="查看更多板块">
        <text>查看更多</text>
        <t-icon name="arrow-right" size="28rpx" />
      </view>
    </view>
    <scroll-view wx:if="{{ recommendationCards.length > 0 }}" class="hg-home__recommend-list" scroll-x enhanced show-scrollbar="{{ false }}">
      <view
        wx:for="{{ recommendationCards }}"
        wx:key="id"
        class="hg-home__recommend-card"
      >
        <view
          wx:for="{{ item.items }}"
          wx:for-item="board"
          wx:key="id"
          class="hg-home__recommend-row {{ selectedBoardId === board.id ? 'hg-home__recommend-row--selected' : '' }}"
          data-id="{{ board.id }}"
          hover-class="hg-home__recommend-row--hover"
          bindtap="onRecommendationTap"
          aria-role="button"
          aria-label="筛选帖子：{{ board.title }}"
        >
          <t-icon class="hg-home__recommend-icon" name="{{ board.icon || 'chat-bubble-1' }}" size="28rpx" />
          <text class="hg-home__recommend-name">{{ board.title }}</text>
          <view
            class="hg-home__recommend-arrow"
            data-id="{{ board.id }}"
            catchtap="onRecommendationOpen"
            aria-role="button"
            aria-label="进入板块 {{ board.title }}"
          >
            <t-icon name="arrow-right" size="24rpx" />
          </view>
        </view>
      </view>
    </scroll-view>
    <view wx:elif="{{ recommendationState === 'empty' }}" class="hg-home__recommend-empty">暂时没有已审核的板块</view>
    <view wx:elif="{{ recommendationState === 'guest' }}" class="hg-home__recommend-empty">选择并加入社团后，可以查看社内板块</view>
    <view wx:elif="{{ recommendationState === 'error' }}" class="hg-home__recommend-empty">板块暂时没加载出来，前往板块页重试</view>
  </view>

  <view class="hg-home__feed-heading">
    <text>帖子</text>
  </view>

  <!-- 筛选 -->
  <scroll-view class="hg-home__filters" scroll-x enhanced show-scrollbar="{{ false }}">
    <view
      wx:for="{{ filters }}"
      wx:key="value"
      class="hg-home__filter {{ (item.value === 'all' && !selectedBoardId) || selectedBoardId === item.value ? 'hg-home__filter--on' : '' }}"
      data-value="{{ item.value }}"
      hover-class="hg-home__filter--hover"
      bindtap="onFilterTap"
      aria-role="button"
    >
      {{ item.label }}
    </view>
  </scroll-view>

  <!-- 未更新提示（保留已加载数据） -->
  <view wx:if="{{ stale }}" class="hg-home__stale">
    <text>内容未更新：{{ errorText }}</text>
    <text class="hg-home__retry" bindtap="onRetry" aria-role="button">重试</text>
  </view>

  <!-- 内容流 -->
  <view class="hg-home__feed">
    <block wx:if="{{ loading && list.length === 0 }}">
      <view class="hg-home__skeleton" wx:for="{{ [1, 2, 3] }}" wx:key="*this">
        <view class="hg-home__skeleton-line"></view>
        <view class="hg-home__skeleton-line hg-home__skeleton-line--short"></view>
      </view>
    </block>

    <block wx:elif="{{ list.length > 0 }}">
      <post-card
        wx:for="{{ list }}"
        wx:key="id"
        post="{{ item }}"
        bind:tapbody="onTapBody"
        bind:tapmedia="onTapMedia"
        bind:taptopic="onTapTopic"
        bind:tapboard="onTapBoard"
        bind:tapauthor="onTapAuthor"
        bind:more="onMore"
        bind:react="onReact"
        bind:bookmark="onBookmark"
      />
    </block>

    <empty-state
      wx:elif="{{ errorText }}"
      icon="error-circle"
      title="没能读到内容"
      desc="{{ errorText }}"
      action="再试一次"
      bind:action="onRetry"
    />

    <empty-state
      wx:else
      icon="pen"
      title="这里还很安静"
      desc="写下第一笔吧。\n一句话、一张照片都可以。"
      action="{{ isMember ? '写一笔' : '' }}"
      bind:action="onCompose"
    />
  </view>

  <!-- 写一笔 -->
  <view class="hg-home__fab" hover-class="hg-home__fab--hover" bindtap="onCompose" aria-role="button" aria-label="写一笔">
    <t-icon name="pen" size="34rpx" />
    <text>写一笔</text>
  </view>

  <scope-picker
    visible="{{ scopeVisible }}"
    value="{{ scopeValue }}"
    allow-public="{{ capabilities.publicScope }}"
    mode="shrink"
    bind:change="onScopeChange"
    bind:close="onScopeClose"
  />
</view>
