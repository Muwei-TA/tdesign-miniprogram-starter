<page-meta page-style="{{ clubThemeStyle }}" />
<view class="hg-page hg-page--tab hg-home {{ isBlackbox ? 'hg-home--blackbox' : '' }}">
  <hg-nav
    theme="transparent"
    show-back="{{ false }}"
  >
    <view slot="left" class="hg-home__nav-left" style="max-width: {{ navLeftMaxWidth }}px">
      <view class="hg-home__club-switch" hover-class="hg-home__club-switch--hover" bindtap="onClubSwitchTap" aria-role="button" aria-label="切换社团">
        <text class="hg-home__club-name">{{ clubName || '选择社团' }}</text>
        <t-icon name="chevron-right" size="28rpx" />
      </view>
      <view class="hg-home__notice" hover-class="hg-home__notice--hover" bindtap="onNoticeTap" aria-role="button" aria-label="消息">
        <t-icon name="notification" size="42rpx" />
        <view wx:if="{{ unread > 0 }}" class="hg-home__notice-dot"></view>
      </view>
    </view>
  </hg-nav>

  <view class="hg-home__filter-wrap">
    <scroll-view class="hg-home__filters" scroll-x enhanced show-scrollbar="{{ false }}">
      <view
        wx:for="{{ filters }}"
        wx:key="value"
        class="hg-home__filter {{ (item.value === 'all' && !selectedBoardId) || selectedBoardId === item.value ? 'hg-home__filter--on' : '' }}"
        data-value="{{ item.value }}"
        hover-class="hg-home__filter--hover"
        bindtap="onFilterTap"
        aria-role="button"
        aria-label="筛选帖子：{{ item.label }}"
        aria-pressed="{{ (item.value === 'all' && !selectedBoardId) || selectedBoardId === item.value }}"
      >
        {{ item.label }}
      </view>
    </scroll-view>
    <view class="hg-home__board-more" hover-class="hg-home__board-more--hover" bindtap="onMoreRecommendations" aria-role="button" aria-label="查看全部板块">
      <t-icon name="arrow-right" size="28rpx" />
    </view>
  </view>
  <view wx:if="{{ recommendationState === 'empty' }}" class="hg-home__board-state">暂时没有可选板块</view>
  <view wx:elif="{{ recommendationState === 'error' }}" class="hg-home__board-state">
    <text>板块暂时没加载出来</text>
    <text class="hg-home__board-retry" hover-class="hg-home__board-retry--hover" bindtap="onRetryRecommendations" aria-role="button">重试</text>
  </view>

  <!-- 未更新提示（保留已加载数据） -->
  <view wx:if="{{ stale }}" class="hg-home__stale">
    <text>内容未更新：{{ errorText }}</text>
    <text class="hg-home__retry" bindtap="onRetry" aria-role="button">重试</text>
  </view>

  <!-- 内容流 -->
  <view class="hg-home__feed">
    <block wx:if="{{ loading && list.length === 0 }}">
      <view class="hg-home__skeleton" wx:for="{{ [1, 2, 3] }}" wx:key="*this">
        <view class="hg-home__skeleton-line"></view>
        <view class="hg-home__skeleton-line hg-home__skeleton-line--short"></view>
      </view>
    </block>

    <block wx:elif="{{ list.length > 0 && isBlackbox }}">
      <view class="hg-home__waterfall">
        <view wx:for="{{ waterfallColumns }}" wx:for-item="column" wx:key="id" class="hg-home__waterfall-column">
          <post-card
            wx:for="{{ column.items }}"
            wx:for-item="postItem"
            wx:key="id"
            post="{{ list[postItem.index] }}"
            mode="waterfall"
            bind:tapbody="onTapBody"
            bind:tapmedia="onTapMedia"
            bind:taptopic="onTapTopic"
            bind:tapboard="onTapBoard"
            bind:tapauthor="onTapAuthor"
            bind:more="onMore"
            bind:react="onReact"
            bind:bookmark="onBookmark"
          />
        </view>
      </view>
    </block>

    <block wx:elif="{{ list.length > 0 }}">
      <post-card
        wx:for="{{ list }}"
        wx:key="id"
        post="{{ item }}"
        bind:tapbody="onTapBody"
        bind:tapmedia="onTapMedia"
        bind:taptopic="onTapTopic"
        bind:tapboard="onTapBoard"
        bind:tapauthor="onTapAuthor"
        bind:more="onMore"
        bind:react="onReact"
        bind:bookmark="onBookmark"
      />
    </block>

    <empty-state
      wx:elif="{{ errorText }}"
      icon="error-circle"
      title="没能读到内容"
      desc="{{ errorText }}"
      action="再试一次"
      bind:action="onRetry"
    />

    <empty-state
      wx:elif="{{ isBlackbox }}"
      icon="image"
      title="还没有作品"
      desc="分享你的第一件作品"
      action="{{ isMember ? '发布作品' : '' }}"
      bind:action="onCompose"
    />
    <empty-state
      wx:else
      icon="pen"
      title="这里还很安静"
      desc="写下第一笔吧。\n一句话、一张照片都可以。"
      action="{{ isMember ? '写一笔' : '' }}"
      bind:action="onCompose"
    />
  </view>

  <!-- 写一笔 -->
  <view class="hg-home__fab" hover-class="hg-home__fab--hover" bindtap="onCompose" aria-role="button" aria-label="{{ isBlackbox ? '发布作品' : '写一笔' }}">
    <t-icon name="{{ isBlackbox ? 'add' : 'pen' }}" size="34rpx" />
    <text>{{ isBlackbox ? '发布作品' : '写一笔' }}</text>
  </view>

  <scope-picker
    visible="{{ scopeVisible }}"
    value="{{ scopeValue }}"
    allow-public="{{ capabilities.publicScope }}"
    mode="shrink"
    bind:change="onScopeChange"
    bind:close="onScopeClose"
  />
</view>
