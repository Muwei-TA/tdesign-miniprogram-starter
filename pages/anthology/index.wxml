<page-meta page-style="{{ clubThemeStyle }}" />
<view class="hg-page hg-page--tab hg-manuscript {{ clubTheme === 'blackbox' ? 'hg-manuscript--blackbox' : '' }}">
  <hg-nav title="文稿" show-back="{{ false }}" />

  <view class="hg-manuscript__intro">
    <view class="hg-manuscript__copy">
      <block wx:if="{{ clubTheme === 'blackbox' }}">
        <view class="hg-manuscript__eyebrow">社内长文</view>
        <view class="hg-manuscript__desc">长文与知识分享。</view>
      </block>
      <block wx:else>
        <view class="hg-manuscript__eyebrow">长文 · 知识分享</view>
        <view class="hg-manuscript__title">
          <view>把知道的，</view>
          <view>认真写下来。</view>
        </view>
        <view class="hg-manuscript__desc">读一篇完整的文章，也分享你实践过的经验。</view>
      </block>
    </view>
    <view
      wx:if="{{ canPublish }}"
      class="hg-manuscript__write"
      hover-class="hg-manuscript__write--hover"
      bindtap="onWriteArticle"
      aria-role="button"
      aria-label="写一篇文稿"
    >
      <t-icon name="edit-1" size="28rpx" />
      <text>写文稿</text>
    </view>
  </view>

  <view wx:if="{{ stale }}" class="hg-manuscript__stale">
    <text>内容未更新：{{ errorText }}</text>
    <text class="hg-manuscript__retry" bindtap="onRetry" aria-role="button">重试</text>
  </view>

  <view wx:if="{{ loading && list.length === 0 }}" class="hg-manuscript__skeleton-list">
    <view wx:for="{{ [1, 2] }}" wx:key="*this" class="hg-manuscript__skeleton">
      <view class="hg-manuscript__skeleton-author"></view>
      <view class="hg-manuscript__skeleton-image"></view>
      <view class="hg-manuscript__skeleton-title"></view>
      <view class="hg-manuscript__skeleton-line"></view>
    </view>
  </view>

  <view wx:elif="{{ list.length > 0 }}" class="hg-manuscript__feed">
    <post-card
      wx:for="{{ list }}"
      wx:key="id"
      mode="article"
      post="{{ item }}"
      can-interact="{{ isMember }}"
      bind:tapbody="onTapBody"
      bind:tapmedia="onTapMedia"
      bind:taptopic="onTapTopic"
      bind:tapboard="onTapBoard"
      bind:tapauthor="onTapAuthor"
      bind:more="onMore"
      bind:react="onReact"
      bind:bookmark="onBookmark"
    />
  </view>

  <empty-state
    wx:elif="{{ errorText }}"
    icon="error-circle"
    title="没能读到文稿"
    desc="{{ errorText }}"
    action="再试一次"
    bind:action="onRetry"
  />

  <empty-state
    wx:elif="{{ !loading && !errorText }}"
    icon="book-open"
    title="还没有文稿"
    desc="这里会出现社内发布的长文与知识分享。"
    action="{{ canPublish ? '写一篇文稿' : '' }}"
    bind:action="onWriteArticle"
  />

  <view wx:if="{{ loadingMore }}" class="hg-manuscript__loading-more">正在加载更多文稿…</view>
  <view wx:elif="{{ list.length > 0 && !hasMore }}" class="hg-manuscript__end">已经读到这里</view>

  <scope-picker
    visible="{{ scopeVisible }}"
    value="{{ scopeValue }}"
    allow-public="{{ capabilities.publicScope }}"
    mode="shrink"
    bind:change="onScopeChange"
    bind:close="onScopeClose"
  />
</view>
