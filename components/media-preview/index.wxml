<view
  wx:if="{{ media }}"
  class="hg-media {{ isGrid ? 'hg-media--grid' : '' }}"
  style="{{ height ? 'height:' + height + ';' : '' }}"
>
  <block wx:if="{{ media.type === 'image' }}">
    <image
      wx:for="{{ images }}"
      wx:key="*this"
      class="hg-media__image"
      src="{{ item }}"
      mode="aspectFill"
      style="{{ height ? 'height:' + height + ';' : '' }}"
      data-index="{{ index }}"
      bindtap="onPreview"
      aria-label="内容配图"
    />
  </block>
  <block wx:elif="{{ media.type === 'video' && media.video }}">
    <view wx:if="{{ media.video.ready }}" class="hg-media__video" bindtap="onPlay" aria-role="button">
      <image
        class="hg-media__image"
        src="{{ media.video.cover }}"
        mode="aspectFill"
        style="{{ height ? 'height:' + height + ';' : '' }}"
        aria-label="视频封面"
      />
      <view class="hg-media__play">▶</view>
      <view wx:if="{{ media.video.duration }}" class="hg-media__duration">{{ media.video.duration }} 秒</view>
    </view>
    <view wx:else class="hg-media__video">
      <image
        class="hg-media__image"
        src="{{ media.video.cover }}"
        mode="aspectFill"
        style="{{ height ? 'height:' + height + ';' : '' }}"
        aria-label="视频封面"
      />
      <view class="hg-media__processing">正在处理，完成后才会展示</view>
      <view wx:if="{{ media.video.duration }}" class="hg-media__duration">{{ media.video.duration }} 秒</view>
    </view>
  </block>
</view>
